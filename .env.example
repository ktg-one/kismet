# ==========================================================
# RESEND - Transactional email for lead notifications
# 1. Create a free account at https://resend.com
# 2. Get your API key at: https://resend.com/api-keys
# 3. Verify kismetfinancegroup.com.au at: https://resend.com/domains
#    (DNS TXT + CNAME records required - Shane or DNS manager must do this)
# 4. Until domain is verified, use LEAD_INBOX_FROM=onboarding@resend.dev for local dev only.
# ==========================================================

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Address Shane receives new lead emails at
LEAD_INBOX_TO=shane@kismetfinancegroup.com.au

# Address emails are sent FROM.
# Production: use hello@kismetfinancegroup.com.au (requires Resend domain verification above).
# Local dev fallback: onboarding@resend.dev (Resend sandbox - no verification required).
LEAD_INBOX_FROM=hello@kismetfinancegroup.com.au

# ==========================================================
# GOOGLE SHEETS - Lead log spreadsheet
# Setup steps (all required before first live lead):
# 1. Create a Google Sheet (any name, e.g. "Kismet Leads").
# 2. Rename the first tab to exactly: Leads
# 3. Add column headers in row 1: Timestamp | Name | Email | Phone | Message
#    (the code appends to range Leads!A:E - tab name and column order must match)
# 4. Go to Google Cloud Console > IAM > Service Accounts. Create a service account.
#    Download the JSON key file. Keep it secret - never commit it.
# 5. Share the Google Sheet (Editor access) with the service account email below.
# 6. Enable Google Sheets API in the Cloud project.
# Sheet ID is the long string in the URL:
#   https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
# ==========================================================

GOOGLE_SHEETS_ID=

# Service account email from the JSON key file (client_email field)
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Private key from the JSON key file (private_key field).
# IMPORTANT: paste as a SINGLE LINE with literal \n sequences - do NOT use real newlines.
# Example (truncated):
#   GOOGLE_SERVICE_ACCOUNT_KEY=-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAA...\n-----END RSA PRIVATE KEY-----\n
# Multi-line values break the env parser. The code converts \n back to real newlines automatically.
GOOGLE_SERVICE_ACCOUNT_KEY=

# ==========================================================
# BOOKING WIDGET
# Paste the embed URL for Shane's booking tool (Calendly or similar).
# Used in the BookingEmbed component. Leave blank to hide the widget entirely.
# Example: https://calendly.com/shane-kismet/30min
# ==========================================================
NEXT_PUBLIC_BOOKING_URL=
